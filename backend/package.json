  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "@stellar/stellar-sdk": "^12.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "csurf": "^1.11.0",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.4.5",
    "expo-server-sdk": "^3.7.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "iconv-lite": "^0.7.2",
    "ioredis": "^5.11.1",
