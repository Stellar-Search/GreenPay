# ── Server & Framework ──────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
SHUTDOWN_TIMEOUT_MS=25000

# Set TRUST_PROXY=true when running behind the nginx ingress controller or a
# cloud load balancer so Express honours X-Forwarded-For and rate limiting keys
# on the real client IP instead of the proxy's. TRUST_PROXY_HOPS counts the
# proxy chain (1 for a single ingress; 2 if a load balancer fronts the ingress).
# Keep both off/false for plain local development — a forged X-Forwarded-For
# is otherwise ignored (fail-safe), never honoured.
TRUST_PROXY=false
TRUST_PROXY_HOPS=1

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/greenpay
DATABASE_SSL=
DATABASE_URL_PREVIOUS=
POSTGRES_PASSWORD_PREVIOUS=

# ── Credential Management & Age Tracking ────────────────────────────────────
CREDENTIAL_ISSUED_AT_POSTGRES=
CREDENTIAL_ISSUED_AT_ADMIN=
CREDENTIAL_ISSUED_AT_MATCHER=
CREDENTIAL_MAX_AGE_DAYS=90

# ── Stellar Network ─────────────────────────────────────────────────────────
STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
CONTRACT_ID=
MATCHER_SECRET_KEY=

# ── Donor Onboarding: Sponsored Reserves ────────────────────────────────────
# Secret key of the account that sponsors donor base reserves so a first-time
# donor can own a Stellar account without funding it past the minimum balance
# first. The platform locks its own XLM behind each account and never holds the
# donor's key. Leave blank to disable the whole sponsored path — every other
# flow, including today's connected-wallet donation, is unaffected.
# Per-account cost and the recovery path: docs/sponsorship-economics.md
SPONSOR_SECRET_KEY=

# Abuse limits. Defaults are deliberately conservative: a limit that is too
# tight costs a donor "try again tomorrow"; one that is too loose costs a
# treasury that cannot serve anybody.
SPONSORSHIP_PER_IP_DAILY=3
SPONSORSHIP_PER_SESSION_TOTAL=1
SPONSORSHIP_GLOBAL_DAILY=500
SPONSORSHIP_GLOBAL_HOURLY=60
SPONSORSHIP_TREASURY_FLOOR_ACCOUNTS=20
SPONSORSHIP_MAX_DONATION_XLM=250
SPONSORSHIP_MAX_LIFETIME_XLM=1000
SPONSORSHIP_RECLAIM_IDLE_DAYS=30

# Per-deployment random value (openssl rand -hex 32) used to hash source
# addresses in onboarding rate-limit rows so those rows are not an IP log.
ONBOARDING_IP_HASH_SALT=

# ── Donor Onboarding: Fiat On-Ramp ──────────────────────────────────────────
# GreenPay never takes fiat. These point at a licensed SEP-24 anchor that does;
# the obligation split is in docs/onramp-compliance.md. Leave blank and the
# fiat path is simply not offered.
ONRAMP_ANCHOR_URL=
ONRAMP_ANCHOR_HOME_DOMAIN=

# ── CORS & Security ──────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://greenpay.app,https://www.greenpay.app,https://stellar-greenpay.app,https://www.stellar-greenpay.app,http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=

# ── Authentication & Secrets ────────────────────────────────────────────────
# JWT secret for admin authentication (generate with: openssl rand -hex 32)
JWT_SECRET=

# Admin login credentials (used by POST /api/v1/admin/login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── Redis & Caching ────────────────────────────────────────────────────────
# Shared by distributed rate-limiting and the Socket.IO adapter that fans live
# donation events across backend replicas. Leave blank for local single-process
# development; set it in any deployment running more than one replica, or half
# the connected donors never see a donation arrive.
REDIS_URL=
CACHE_MAX_ENTRIES=500
CACHE_SWEEP_INTERVAL_MS=60000

# ── Email & Notifications ──────────────────────────────────────────────────
# Transactional email — get a free API key at https://resend.com
RESEND_API_KEY=
EMAIL_FROM=GreenPay <updates@greenpay.app>
APP_URL=http://localhost:3000

# ── AI & Summaries ─────────────────────────────────────────────────────────
# Anthropic Claude API — required for AI project summaries
ANTHROPIC_API_KEY=
CLAUDE_SUMMARY_MODEL=claude-opus-4-7
SUMMARY_FAILURE_ALERT_WEBHOOK_URL=

# ── Turrets Matching Service ──────────────────────────────────────────────
ENABLE_TURRETS=false
TURRETS_PORT=3001

# ── Observability ────────────────────────────────────────────────────────────
SERVICE_NAME=greenpay-backend

# ── Event Sourcing (Optional) ─────────────────────────────────────────────
# See docs/performance.md for capacity numbers
# EVENT_STORE_BATCH_SIZE=200
# EVENT_STORE_MAX_BATCH_SIZE=2000
# EVENT_STORE_POLL_INTERVAL_MS=500
# EVENT_STORE_CATCHUP_INTERVAL_MS=10
# EVENT_STORE_ADAPTIVE_BATCH=true
