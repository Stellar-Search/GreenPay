{
  "name": "greenpay-mobile",
  "version": "0.1.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "jest"
  },
  "dependencies": {
    "@expo-google-fonts/lora": "^0.4.2",
    "@react-native-async-storage/async-storage": "^1.23.0",
    "@react-native-community/netinfo": "11.3.1",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.17",
    "@stellar/stellar-sdk": "^12.0.0",
    "axios": "^1.7.0",
    "expo": "~51.0.0",
    "expo-constants": "~16.0.0",
    "expo-updates": "~0.25.0",
    "expo-barcode-scanner": "~13.0.1",
    "expo-font": "^57.0.1",
    "expo-linking": "~6.3.0",
    "expo-local-authentication": "~14.0.0",
    "expo-notifications": "~0.28.0",
    "expo-router": "~3.5.0",
    "expo-secure-store": "~13.0.1",
    "expo-sharing": "~12.0.0",
    "expo-splash-screen": "^57.0.7",
    "expo-status-bar": "~1.12.0",
    "@sentry/react-native": "^5.22.0",
    "jail-monkey": "^2.8.5",
    "react": "18.2.0",
    "react-native": "0.74.1",
    "react-native-safe-area-context": "4.10.1",
    "react-native-screens": "3.31.1",
    "react-native-view-shot": "^3.8.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.5.1",
    "@types/jest": "^29.5.12",
    "@types/react": "^18.3.31",
    "@types/react-native": "^0.72.8",
    "fast-check": "^3.19.0",
    "jest": "^29.7.0",
    "jest-expo": "~51.0.0",
    "react-test-renderer": "18.2.0"
  },
  "overrides": {
    "turbo-stream": ">=3.0.0"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "@testing-library/jest-native/extend-expect"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?/|@react-native/)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|@stellar/.*)"
    ],
    "moduleNameMapper": {
      "^axios$": "<rootDir>/__mocks__/axios.js",
      "^expo-local-authentication$": "<rootDir>/__mocks__/expo-local-authentication.js",
      "^expo-barcode-scanner$": "<rootDir>/__mocks__/expo-barcode-scanner.js",
      "^@sentry/react-native$": "<rootDir>/__mocks__/@sentry/react-native.js",
      "^expo-updates$": "<rootDir>/__mocks__/expo-updates.js",
      "^expo-constants$": "<rootDir>/__mocks__/expo-constants.js"
    }
  }
}
