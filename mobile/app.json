{
  "expo": {
    "name": "Stellar GreenPay",
    "slug": "stellar-greenpay",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprintExperimental"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#227239"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stellargreenpay.app",
      "buildNumber": "1",
      "associatedDomains": ["applinks:greenpay.app"],
      "infoPlist": {
        "NSCameraUsageDescription": "Allow GreenPay to access your camera to scan QR codes.",
        "NSFaceIDUsageDescription": "Allow GreenPay to use Face ID or Touch ID to securely authenticate."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#227239"
      },
      "package": "com.stellargreenpay.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "greenpay" }],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "greenpay.app",
              "pathPrefix": "/donate"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-updates",
        {
          "url": "https://u.expo.dev/REPLACE_WITH_PROJECT_ID",
          "checkAutomatically": "ON_LOAD",
          "fallbackToCacheTimeout": 10000
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "greenpay",
          "project": "greenpay-mobile"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#227239",
          "sounds": []
        }
      ]
    ],
    "scheme": "greenpay"
  }
}
