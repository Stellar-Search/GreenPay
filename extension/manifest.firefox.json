{
  "manifest_version": 3,
  "name": "GreenPay Extension",
  "version": "1.0.0",
  "description": "GreenPay browser extension for tracking carbon offsets and donations.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "GreenPay"
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "greenpay@example.com",
      "strict_min_version": "120.0"
    }
  }
}
