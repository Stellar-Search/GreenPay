{
  "title": "GreenPay — Donation Path",
  "uid": "greenpay-donation-path",
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Donation outcomes (rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(greenpay_donation_outcomes_total[5m])) by (status)",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Donation failures by mode (rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(greenpay_donation_outcomes_total{status=\"failure\"}[5m])) by (failure_mode)",
          "legendFormat": "{{failure_mode}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Projection lag",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "expr": "greenpay_projection_lag_seconds", "legendFormat": "lag" }
      ]
    },
    {
      "id": 4,
      "title": "Event-store adaptive batch size",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "targets": [
        { "expr": "greenpay_event_store_batch_size", "legendFormat": "batch size" }
      ]
    },
    {
      "id": 5,
      "title": "Consecutive saturated batches",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "targets": [
        { "expr": "greenpay_event_store_consecutive_saturated_batches", "legendFormat": "consecutive saturated" }
      ]
    },
    {
      "id": 6,
      "title": "Job queue depth",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        { "expr": "greenpay_job_queue_depth", "legendFormat": "{{queue}}" }
      ]
    },
    {
      "id": 7,
      "title": "Job permanent failures (rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(greenpay_job_permanent_failures_total[1h])) by (queue)",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Chain request latency (p50 / p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(greenpay_chain_request_duration_seconds_bucket[5m])) by (le, operation))",
          "legendFormat": "p50 {{operation}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(greenpay_chain_request_duration_seconds_bucket[5m])) by (le, operation))",
          "legendFormat": "p95 {{operation}}"
        }
      ]
    },
    {
      "id": 9,
      "title": "Chain request error rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(greenpay_chain_request_errors_total[5m])) by (operation) / sum(rate(greenpay_chain_request_duration_seconds_count[5m])) by (operation)",
          "legendFormat": "{{operation}}"
        }
      ]
    },
    {
      "id": 10,
      "title": "Backend HTTP request rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[5m])) by (route)",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 11,
      "title": "Backend HTTP 5xx rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 32 },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{code=~\"5..\"}[5m])) / sum(rate(http_requests_total[5m]))",
          "legendFormat": "5xx rate"
        }
      ]
    },
    {
      "id": 12,
      "title": "Backend HTTP p99 latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 32 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    }
  ]
}
